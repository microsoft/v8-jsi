}

# In-process codec conformance tests for //v8host:protocol. No pipes or spawned
# processes (no data_deps), and only the codec header is needed: protocol/ is on
# the include path via the :protocol public config, and v8host_test_support.h
# resolves same-dir.
executable("v8host_protocol_tests") {
  testonly = true
  sources = [
    "tests/v8host_protocol_tests.cc",
    "tests/v8host_test_support.cc",
    "tests/v8host_test_support.h",
  ]
  deps = [
    ":protocol",
    ":payload_identity",
  ]
}

# Deterministic, in-process conformance tests for the neutral run-envelope codec
# (:run_envelope): round-trips + reject paths over pure byte vectors, no pipes or
# spawned processes. Mirrors v8host_protocol_tests.
executable("v8host_run_envelope_tests") {
  testonly = true
  sources = [
    "tests/v8host_run_envelope_tests.cc",
    "tests/v8host_test_support.cc",
    "tests/v8host_test_support.h",
  ]
  deps = [ ":run_envelope" ]
}

# Deterministic in-process fuzz harness for //v8host:protocol. Mutates a built-in
# + on-disk corpus and feeds the bytes to every decoder, proving robustness (no
# crash/hang/unbounded allocation) on arbitrary input. NOT libFuzzer (that config
# is x64+ASan-only and off by default here); a plain executable is portable
# across x86/x64/arm64 and flake-free. Only the codec is linked — the corpus dir
# is passed by path arg at run time (the lone bit of Win32 lives in the harness).
executable("v8host_protocol_fuzz") {
  testonly = true
  sources = [ "tests/v8host_protocol_fuzz.cc" ]
  deps = [ ":protocol" ]
}

# Deterministic, in-process unit tests for the app-thread callback dispatcher
# (:dispatcher). The test IS the app thread: it initializes the dispatcher on
# its main thread, drives posts from worker std::threads, pumps the message loop
# with a bounded deadline, and asserts app-thread delivery, ordering, table
# snapshots, backpressure, reentrancy, close suppression, and one-terminal-per-
# run. No pipes or spawned processes (no data_deps); the dispatcher public
# config supplies the client/ and public-header include paths, and
# v8host_test_support.h resolves same-dir. user32 is needed for the message
# pump in the test TU itself.
executable("v8host_dispatcher_tests") {
  testonly = true
  defines = [ "V8HOST_DISPATCHER_TESTING" ]
  configs += [ ":dispatcher_config" ]
  sources = [
    "client/v8host_dispatcher.cc",
    "client/v8host_dispatcher.h",
    "tests/v8host_dispatcher_tests.cc",
    "tests/v8host_test_support.cc",
    "tests/v8host_test_support.h",
  ]
  # Without a manifest, Windows treats a 32-bit exe whose name contains "patch"
  # (dis-patch-er) as an installer and demands elevation.
  deps = [
    "//build/win:default_exe_manifest",
  ]
  libs = [
    "user32.lib",
    "bcrypt.lib",
  ]
}

executable("v8host_client_tests") {
  testonly = true
  sources = [
    "client/v8host_client.cc",
    "client/v8host_client_pipe_transport.cc",
    "client/v8host_broker_rendezvous.cc",
    "client/v8host_dispatcher.cc",
    "client/v8host_dispatcher.h",
    "tests/v8host_client_test_config.h",
    "tests/v8host_client_tests.cc",
    "tests/v8host_test_support.cc",
    "tests/v8host_test_support.h",
  ]
  deps = [ ":protocol", ":payload_identity", ":peer_auth" ]
  include_dirs = [
    "client",
    "//../../src/public",
  ]
  defines = [
    "V8HOST_CLIENT_TESTING",
    "V8HOST_DISPATCHER_TESTING",
  ]
  libs = [ "user32.lib" ]
  # Real rendezvous cases use the adjacent broker and plugin.
  data_deps = [ ":v8host", "//sbox:sbox" ]
}

executable("v8host_cross_arch_tests") {
  testonly = true
  sources = [ "tests/v8host_cross_arch_tests.cc" ]
  include_dirs = [ "//../../src/public" ]
  libs = [
    "bcrypt.lib",
    "user32.lib",
  ]
}

# Deterministic, in-process unit tests for the sbox_config builder: the
# status-returning sbox_config_api setters + the MarshalSboxConfig discard gate
# (//sbox:sbox_config). No pipes or spawned processes — it drives the real
# setter vtable and the marshal gate directly, so every setter success/failure,
# the 64/64 + 4 KiB limits, the AppContainer cross-field rules, and the key safety
# property "a poisoned builder spawns no worker" are all checked without a worker.
executable("v8host_config_tests") {
  testonly = true
  sources = [
    "tests/v8host_config_tests.cc",
    "tests/v8host_test_support.cc",
    "tests/v8host_test_support.h",
  ]
  deps = [ "//sbox:sbox_config" ]
  public_configs = [ ":v8host_common_config" ]
  defines = [ "SBOX_STATIC" ]
}

# Deterministic, in-process conformance tests for the neutral spawn/worker-profile
# codec (:spawn_config) and the engine's real spawn-config -> sbox setter lowering
# (v8host_spawn_apply.cc, compiled in). No pipes or spawned processes: the codec
# round-trips/rejects are pure byte vectors, and the lowering is driven onto the
# real MakeConfigApi builder + MarshalSboxConfig gate (//sbox:sbox_config)
# so the configure() path is exercised without a worker. Mirrors
# v8host_protocol_tests (byte vectors) + v8host_config_tests (real builder).
executable("v8host_spawn_config_tests") {
  testonly = true
  sources = [
    "tests/v8host_spawn_config_tests.cc",
    "tests/v8host_test_support.cc",
    "tests/v8host_test_support.h",
    "v8host_spawn_apply.cc",
    "v8host_spawn_apply.h",
  ]
  deps = [
    ":spawn_config",
    "//sbox:sbox_config",
  ]

  # v8host_spawn_apply.h lives in the v8host root (next to v8host_engine.cc); put
  # it on the include path so the test .cc (in tests/) can reach the lowering.
  include_dirs = [ "." ]
  defines = [ "SBOX_STATIC" ]
}

