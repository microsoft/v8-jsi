# Generic broker test harness (consumes only the sbox.dll C API; no Chromium
# internals, no V8). Two variants share test_app.cc:
#   test_app        — dev opt-in tolerates UNSIGNED; runs the pre-signing tier.
#   test_app_signed — fails closed on unsigned; runs the ESRP-signed binaries to
#                     prove they carry valid signatures AND spawn a full round trip.

_test_app_common = {
  sources = [ "test_app.cc" ]
  include_dirs = [ "//sandbox_dll" ]  # sbox.h, sbox_harden.h
  deps = [ "//sandbox_dll:sbox" ]
  libs = [ "wintrust.lib" ]  # WinVerifyTrust (signature check)

  # Resolve statically-imported DLLs (incl. sbox.dll) only from System32 + the
  # application directory — neutralizes current-directory / PATH planting.
  ldflags = [ "/DEPENDENTLOADFLAG:0xA00" ]
}

executable("test_app") {
  forward_variables_from(_test_app_common, "*")
  defines = [ "SBOX_DEV_ALLOW_UNSIGNED" ]  # tolerate unsigned dev binaries
}

executable("test_app_signed") {
  forward_variables_from(_test_app_common, "*")  # no dev define: fails closed
}

if (current_cpu == "x64") {
  executable("sbox_trust_transition_target") {
    testonly = true
    sources = [ "sbox_trust_transition_target.cc" ]
    include_dirs = [
      ".",
      "//sandbox_dll",
    ]
    deps = [ "//sandbox_dll:sbox_trust_transition_test" ]
    defines = [ "SBOX_TRUST_TRANSITION_TESTING" ]
    ldflags = [ "/DEPENDENTLOADFLAG:0xA00" ]
  }

  executable("sbox_trust_transition_tests") {
    testonly = true
    sources = [ "sbox_trust_transition_tests.cc" ]
    include_dirs = [
      ".",
      "//sandbox_dll",
    ]
    deps = [ "//sandbox_dll:sbox_trust_transition_test" ]
    defines = [ "SBOX_TRUST_TRANSITION_TESTING" ]
    libs = [ "userenv.lib" ]
    ldflags = [ "/DEPENDENTLOADFLAG:0xA00" ]
  }
}
