<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Microsoft.JavaScript.LibNode.$rid$</id>
    <version>$version$</version>
    <description>Node.js library</description>
    <title>Node.js library</title>
    <authors>Microsoft</authors>
    <projectUrl>https://nodejs.org/</projectUrl>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>&#169; Microsoft Corporation. All rights reserved.</copyright>
    <repository type="git" url="$repoUrl$" branch="$repoBranch$" commit="$repoCommit$" />
    <icon>icon.png</icon>
    <language>en-US</language>
    <readme>README.md</readme>
    <tags>native JavaScript JS V8 library node.js node NodeAPI Node-API NAPI</tags>
  </metadata>
  <files>
    <file src="$nugetroot$\build\native\include\**\*.*"
          target="build\native\include" />
    <!-- The libnode.lib is Windows-only. We use the *.lib pattern to copy the optional file. -->
    <file src="$nugetroot$\build\native\$rid$\*.lib"
          target="build\native\$rid$\" />
    <file src="$nugetroot$\Microsoft.JavaScript.LibNode.native.$rid$.props"
          target="build\native\Microsoft.JavaScript.LibNode.$rid$.props" />
    <file src="$nugetroot$\Microsoft.JavaScript.LibNode.native.$rid$.targets"
          target="build\native\Microsoft.JavaScript.LibNode.$rid$.targets" />
    <file src="$nugetroot$\Microsoft.JavaScript.LibNode.net461.$rid$.props"
          target="buildTransitive\net461\Microsoft.JavaScript.LibNode.$rid$.props" />
    <file src="$nugetroot$\Microsoft.JavaScript.LibNode.net461.$rid$.targets"
          target="buildTransitive\net461\Microsoft.JavaScript.LibNode.$rid$.targets" />
    <file src="$nugetroot$\_._" target="lib\netstandard2.0\" />
    <file src="$nugetroot$\build\native\$rid$\$libnodeName$"
          target="runtimes\$rid$\native\$libnodeName$" />
    <file src="$nugetroot$\LICENSE" target="LICENSE" />
    <file src="$nugetroot$\NOTICE.txt" target="" />
    <file src="$nugetroot$\README.md" target="" />
    <file src="$nugetroot$\icon.png" target="" />
  </files>
</package>
