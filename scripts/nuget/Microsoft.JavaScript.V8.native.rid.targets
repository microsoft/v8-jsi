<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Identical across RID packages: the last import validates all available RIDs. -->
  <Target Name="V8JsiValidateRuntimeIdentifier" BeforeTargets="PrepareForBuild">
    <Error Condition=" '$(Platform)' == 'ARM64EC' AND '$(UseV8Sandbox)' == 'True' "
           Text="UseV8Sandbox supports x64 and ARM64 consumers only. x86 and ARM64EC clients need the cross-architecture install layout described in docs\v8sbhost-sandbox.md, which this package does not stage." />
    <!-- Unmapped platforms keep an empty RID and receive no engine wiring or availability error. -->
    <Error Code="V8JSI001"
           Condition=" '$(V8JsiRuntimeIdentifier)' != '' AND !$([System.String]::Copy(';$(V8JsiAvailableRuntimeIdentifiers);').ToLowerInvariant().Contains($([System.String]::Copy(';$(V8JsiRuntimeIdentifier);').ToLowerInvariant()))) "
           Text="V8 JSI runtime '$(V8JsiRuntimeIdentifier)' is not available. Restore and import the matching RID package; no architecture fallback is supported." />
  </Target>

  <!-- Fail before linking/copying rather than silently dropping a missing RID dependency. -->
  <Target Name="V8JsiValidatePayload_$rid$" BeforeTargets="PrepareForBuild"
          DependsOnTargets="V8JsiValidateRuntimeIdentifier"
          Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' ">
    <Error Code="V8JSI001"
           Condition=" '$(V8JsiAddLibDependency)' == 'True' AND !Exists('$(MSBuildThisFileDirectory)$rid$\$v8jsiName$.lib') "
           Text="Missing V8 JSI import library for '$rid$': $([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$rid$', '$v8jsiName$.lib')). The imported RID package is incomplete; restore it again; no architecture fallback is supported." />
    <Error Code="V8JSI001"
           Condition=" '$(V8JsiCopyDLL)' == 'True' AND !Exists('$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\$v8jsiName$') "
           Text="Missing V8 JSI engine DLL for '$rid$': $([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'runtimes', '$rid$', 'native', '$v8jsiName$')). The imported RID package is incomplete; restore it again; no architecture fallback is supported." />
  </Target>

  <!-- Add include paths to header files. -->
  <ItemDefinitionGroup Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' ">
    <ClCompile>
      <AdditionalIncludeDirectories Condition="'$(V8JsiIncludePublicHeaders)' == 'True'">%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)include;$(MSBuildThisFileDirectory)jsi</AdditionalIncludeDirectories>
      <!-- Node-API hosting needs the C ABI types even when JSI public headers are disabled. -->
      <AdditionalIncludeDirectories Condition="'$(V8JsiIncludeNodeApiHeaders)' == 'True'">%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)include;$(MSBuildThisFileDirectory)include\node-api;$(MSBuildThisFileDirectory)include\node-api-jsi;$(MSBuildThisFileDirectory)jsi</AdditionalIncludeDirectories>
      <!-- The public client C ABI for sandbox consumers. -->
      <AdditionalIncludeDirectories Condition="'$(UseV8Sandbox)' == 'True'">%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)include;$(MSBuildThisFileDirectory)include\v8sbhost</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- The client import must load normally, not through delayimp. The engine
       v8jsi2sb.dll is loaded by the worker and needs no consumer import lib. -->
  <ItemDefinitionGroup Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' AND '$(UseV8Sandbox)' == 'True' ">
    <Link>
      <AdditionalDependencies>v8sbhost.dll.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)$rid$;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- Add $v8jsiName$.lib dependency required for MSVC C++ linker if it is part of this package. -->
  <ItemDefinitionGroup Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' AND '$(V8JsiAddLibDependency)' == 'True' AND Exists('$(MSBuildThisFileDirectory)$rid$\$v8jsiName$.lib') ">
    <Link>
      <AdditionalDependencies>$v8jsiName$.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)$rid$;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <DelayLoadDLLs>$v8jsiName$;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>

  <!-- Consumer-side translation units.
       jsi.cpp ships the JSI base-class implementations (Buffer/Value/JSError/
       Runtime destructors and virtual default impls). $v8jsiName$ does not export
       these symbols (JSI_EXPORT is a no-op unless CREATE_SHARED_LIBRARY is set,
       which v8jsi.gyp doesn't define), so every consumer compiles jsi.cpp
       locally.
       V8JsiRuntime.cpp holds makeV8Runtime + the V8ScriptCache and V8TaskRunner
       adapters. JsiAbiRuntime.cpp is the C++ wrapper that implements
       jsi::Runtime over the JSI ABI vtable. Both compile against $v8jsiName$'s
       C exports (v8_jsi_abi_runtime_create, v8_jsi_abi_config_set_*, etc.). -->
  <ItemGroup Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' AND '$(V8JsiAddConsumerSourceTUs)' == 'True' ">
    <ClCompile Include="$(MSBuildThisFileDirectory)jsi\jsi\jsi.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)jsi\public\V8JsiRuntime.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)jsi\jsi_abi\JsiAbiRuntime.cpp" />
  </ItemGroup>

  <!-- Copy $v8jsiName$ (and PDB if shipped) to the output directory. -->
  <ItemGroup Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' AND '$(V8JsiCopyDLL)' == 'True' ">
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\$v8jsiName$" />
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\$v8jsiName$" CopyToOutputDirectory="PreserveNewest" />
    <!-- PDB is optional. Stage B2 / C-onward release packs include it; the
         Exists() guard lets consumer builds pass when no PDB ships. -->
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\$v8jsiName$.pdb"
                             Condition="Exists('$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\$v8jsiName$.pdb')" />
  </ItemGroup>

  <!-- Sandbox opt-in requires all three shipped binaries. Test executables
       are never packaged.
       Supported: same-architecture x64 and ARM64 clients. The shipped binaries
       require the payload and the client DLL in `<install-root>\<arch>\`
       (docs\v8sbhost-sandbox.md). Copy-local keeps the app and payload together;
       validate the output directory rather than relocating it.
       x86 and ARM64EC consumers need a cross-architecture
       layout this package does not stage yet. -->
  <Target Name="V8SbHostSandboxUnsupportedPlatform_$rid$" BeforeTargets="PrepareForBuild"
          Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' AND '$(UseV8Sandbox)' == 'True' AND (('$rid$' != 'win-x64' AND '$rid$' != 'win-arm64') OR 'win-$(Platform)' != '$rid$' OR ('$(V8Platform)' != '' AND 'win-$(V8Platform)' != '$rid$')) ">
    <Error Text="UseV8Sandbox supports x64 and ARM64 consumers only. x86 and ARM64EC clients need the cross-architecture install layout described in docs\v8sbhost-sandbox.md, which this package does not stage." />
  </Target>
  <Target Name="V8SbHostSandboxValidateOutputDirectory_$rid$" AfterTargets="PrepareForBuild"
          BeforeTargets="AssignTargetPaths;CopyFilesToOutputDirectory"
          DependsOnTargets="V8SbHostSandboxUnsupportedPlatform_$rid$"
          Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' AND '$(UseV8Sandbox)' == 'True' ">
    <PropertyGroup>
      <_V8SbHostSandboxArch>$rid$</_V8SbHostSandboxArch>
      <_V8SbHostSandboxArch>$(_V8SbHostSandboxArch.Replace('win-', ''))</_V8SbHostSandboxArch>
      <_V8SbHostSandboxOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</_V8SbHostSandboxOutDir>
      <_V8SbHostSandboxOutLeaf>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('$(_V8SbHostSandboxOutDir)'))))</_V8SbHostSandboxOutLeaf>
      <_V8SbHostSandboxTargetDir Condition="'$(TargetDir)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(TargetDir)'))</_V8SbHostSandboxTargetDir>
    </PropertyGroup>
    <Error Code="V8SBHOST001"
           Condition="'$(OutDir)' == '' OR '$(_V8SbHostSandboxOutLeaf)' != '$(_V8SbHostSandboxArch)' OR ('$(TargetDir)' != '' AND '$(_V8SbHostSandboxTargetDir)' != '$(_V8SbHostSandboxOutDir)')"
           Text="UseV8Sandbox requires the application and payload together in an output directory named '$(_V8SbHostSandboxArch)'. Set &lt;OutDir&gt;...\$(_V8SbHostSandboxArch)\&lt;/OutDir&gt; and keep TargetDir equal to OutDir. The sandbox payload is one signed same-architecture version set; do not mix files from different versions." />
  </Target>
  <ItemGroup Condition=" '$(V8JsiRuntimeIdentifier)' == '$rid$' AND '$(UseV8Sandbox)' == 'True' ">
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\v8jsi2sb.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\sbox.exe" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\v8sbhost.dll" />
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\v8jsi2sb.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\sbox.exe"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\$rid$\native\v8sbhost.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
