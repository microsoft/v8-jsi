  "results": {
    "b66676be4d3fd6e1bbcd588157da6e5fd32bdf08223dc622a2e2cbf9af378c89": {
      "signature": "b66676be4d3fd6e1bbcd588157da6e5fd32bdf08223dc622a2e2cbf9af378c89",
      "target": "out-new/pkg-staging/build/native/win-x64/v8jsi2.dll",
      "memberOf": [
        "default"
      ],
      "tool": "binskim",
      "ruleId": "BA2014",
      "createdDate": "2026-11-17 00:00:00Z",
      "justification": "BA2014 fires on three compiler-generated 'default constructor closure' thunks (??_F...) in upstream V8 (DefaultPlatform, CpuProfilingOptions, SnapshotCreator), emitted into the vendored V8 static libs. The thunks carry no stack buffers, so /GS inserts no cookie and there is nothing to guard -- a false positive, not disabled protection in v8-jsi code. They come from V8's own compilation, so we cannot reflag them without patching vendored V8 (/sdl on V8 did not clear them and costs engine-wide perf). Accepted as a residual; the actionable rules (CFG, ASLR, NX, Spectre, secure hashing) are enabled via src/v8jsi_settings.gypi. Signature is per-RID."
    },
    "8e7b95843f601216c307cf43e17e01ce6b2637999ce1901d739eea40ac03ee55": {
      "signature": "8e7b95843f601216c307cf43e17e01ce6b2637999ce1901d739eea40ac03ee55",
      "target": "out-new/pkg-staging/build/native/win-x86/v8jsi2.dll",
      "memberOf": [
        "default"
      ],
      "tool": "binskim",
      "ruleId": "BA2014",
      "createdDate": "2026-11-17 00:00:00Z",
      "justification": "BA2014 on win-x86 v8jsi2.dll -- same root cause as the win-x64 entry: buffer-less 'default constructor closure' thunks (??_F...) in upstream V8's vendored static libs. A false positive, not fixable without patching V8. Per-RID signature, hence a separate entry."
    },
    "d5c43077d15fb9ffb62e0afaea70e5492ed53fa6c7e581d83aeba68543f4c15c": {
      "signature": "d5c43077d15fb9ffb62e0afaea70e5492ed53fa6c7e581d83aeba68543f4c15c",
      "target": "out-new/pkg-staging/build/native/win-x86/v8jsi2.dll",
      "memberOf": [
        "default"
      ],
      "tool": "binskim",
      "ruleId": "BA2018",
      "createdDate": "2026-11-17 00:00:00Z",
      "justification": "BA2018 (EnableSafeSEH) on win-x86 v8jsi2.dll. SafeSEH is x86-only and needs every linked object to register safe handlers (.sxdata). clang-cl (required by Node.js >= 24) emits none, and V8's x86 build links hand-written asm (push_registers_asm.obj) that is not SafeSEH-aware, so the linker can't produce a /SAFESEH image. A clang-cl/x86 toolchain limitation, not a v8-jsi defect; x86-only. Accepted as a residual."
    },
    "7ba9ebafa9af2a842e173b81a639a5be05cad3556f66c59755513dab21ae8163": {
